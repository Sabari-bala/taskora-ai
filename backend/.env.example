# ─── Django Core ────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ─── Database ───────────────────────────────────
# DATABASE_URL=postgres://taskora:taskora@localhost:5432/taskora

# ─── CORS / CSRF ────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ─── JWT ────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_COOKIE_SECURE=False

# ─── AI Provider ────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── AI Guardrails ──────────────────────────────
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=4000
AI_RATE_LIMIT_PER_HOUR=30

# ─── Frontend URL (for email links) ─────────────
FRONTEND_URL=http://localhost:5173

# ─── Email ──────────────────────────────────────
# Dev default: console backend (emails print to Django terminal)
# Prod: switch to SMTP with a provider like Resend, Mailgun, or Gmail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Taskora AI <noreply@taskora.local>

# ─── Frontend (Vite) ────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
